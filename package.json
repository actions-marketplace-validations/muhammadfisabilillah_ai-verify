{
  "name": "@fisaabil_/ai-verify",
  "version": "0.2.1",
  "description": "Open-source, risk-adaptive verification infrastructure for AI-generated software",
  "main": "./dist/cli/index.js",
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "prepublishOnly": "npm run check && npm run format:check && npm run test && npm run build"
  },
  "keywords": [
    "ai",
    "verification",
    "code-review",
    "static-analysis",
    "devtools",
    "cli"
  ],
  "author": "Muhammad Fisabilillah",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "ai-verify": "dist/cli/index.js",
    "ai-verify-mcp": "dist/mcp/server.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.1"
  }
}
